# Backend Python novo (apps/api) — base URL da API que o front consome (Fatia 5)
VITE_API_URL="http://localhost:8000"

# Supabase Configuration (legado — sai no cutover)
VITE_SUPABASE_PROJECT_ID="seu_project_id_aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="seu_publishable_key_aqui"
VITE_SUPABASE_URL="https://seu_project.supabase.co"
VITE_ESOCIAL_BACKEND_URL="https://seu-backend-esocial.exemplo.com"
# Opcional: só use em homologação/desenvolvimento se o backend exigir X-API-Key na rota /api/esocial/config
VITE_ESOCIAL_CONFIG_API_KEY=""

# Application Environment
ESOCIAL_AMBIENTE="homologacao"
NODE_ENV="production"
PORT="3001"

# SSL/TLS Certificate (if needed)
CERT_PASSWORD=""

# Frontend URL (EasyPanel)
FRONTEND_URL="https://seu-dominio.easypanel.host/"

# ---------------------------------------------------------------------------
# Backend Python (apps/api) — preencher o real em apps/api/.env
# ---------------------------------------------------------------------------

# Postgres (EasyPanel db-toriq-corp)
DATABASE_URL=postgresql+asyncpg://toriq_corp:SENHA@IP_PUBLICO_DA_VPS:5432/db-toriq-corp

# API / Auth
JWT_SECRET=troque-isto-por-um-segredo-forte
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
# Seguro por padrão (True). Defina como false APENAS em dev local (HTTP / Postgres sem TLS).
COOKIE_SECURE=true
DB_SSL=true

# Storage (RustFS S3-compatível) — substitui o supabase.storage.
# Sem credenciais, o subsistema /storage responde 503 "storage não configurado".
# S3_ENDPOINT_URL=http://69.62.89.220:9000
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# Base pública opcional (CDN/proxy). Sem ela, a URL pública usa o endpoint.
# S3_PUBLIC_BASE_URL=http://69.62.89.220:9000
